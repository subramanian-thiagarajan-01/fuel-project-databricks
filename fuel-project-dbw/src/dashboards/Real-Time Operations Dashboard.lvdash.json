{
  "datasets": [
    {
      "name": "ef2d65f9",
      "displayName": "Counter Stats",
      "queryLines": [
        "SELECT \r\n",
        "     SUM(revenue_last_hour) as current_hour_revenue,\r\n",
        "     COUNT(DISTINCT fuel_station_id) as active_stations,\r\n",
        "     AVG(avg_transaction_time_sec) as avg_service_time,\r\n",
        "     SUM(transactions_last_hour) as total_transactions\r\n",
        "   FROM fuel_project_dev.gold.vw_realtime_station_snapshot\r\n",
        "   WHERE transactions_last_hour > 0;"
      ],
      "catalog": "fuel_project_dev",
      "schema": "gold"
    },
    {
      "name": "db7ddd59",
      "displayName": "Fuel Station Activity Overview",
      "queryLines": [
        "SELECT \r\n",
        "     fuel_station_id,\r\n",
        "     manager_name,\r\n",
        "     latitude,\r\n",
        "     longitude,\r\n",
        "     revenue_last_hour,\r\n",
        "     transactions_last_hour,\r\n",
        "     CASE \r\n",
        "       WHEN transactions_last_hour > 20 THEN 'High'\r\n",
        "       WHEN transactions_last_hour > 10 THEN 'Medium'\r\n",
        "       ELSE 'Low'\r\n",
        "     END as activity_level\r\n",
        "   FROM fuel_project_dev.gold.vw_realtime_station_snapshot;"
      ],
      "catalog": "fuel_project_dev",
      "schema": "gold"
    },
    {
      "name": "0e4eccdb",
      "displayName": "Fuel Revenue Analysis for Recent Transactions",
      "queryLines": [
        "SELECT \r\n",
        "     fuel_type,\r\n",
        "     SUM(revenue) as revenue\r\n",
        "   FROM fuel_project_dev.gold.fact_fuel_transactions\r\n",
        "   WHERE start_time >= current_timestamp() - interval 1 hour\r\n",
        "   GROUP BY fuel_type;"
      ]
    },
    {
      "name": "462e7155",
      "displayName": "Top Revenue Fuel Stations Snapshot",
      "queryLines": [
        "SELECT \r\n",
        "     fuel_station_id,\r\n",
        "     revenue_last_hour\r\n",
        "   FROM fuel_project_dev.gold.vw_realtime_station_snapshot\r\n",
        "   ORDER BY revenue_last_hour DESC\r\n",
        "   LIMIT 10;"
      ]
    },
    {
      "name": "69f530a1",
      "displayName": "Fuel Transaction Insights Over Recent Hours",
      "queryLines": [
        "SELECT \r\n",
        "     date_trunc('hour', start_time) as hour,\r\n",
        "     COUNT(*) as transaction_count,\r\n",
        "     SUM(revenue) as revenue\r\n",
        "   FROM fuel_project_dev.gold.fact_fuel_transactions\r\n",
        "   WHERE start_time >= current_timestamp() - interval 6 hours\r\n",
        "   GROUP BY date_trunc('hour', start_time)\r\n",
        "   ORDER BY hour;"
      ]
    },
    {
      "name": "d70a399e",
      "displayName": "Fuel Station Activity Overview Report",
      "queryLines": [
        "SELECT \r\n",
        "     fuel_station_id,\r\n",
        "     manager_name,\r\n",
        "     transactions_last_hour,\r\n",
        "     revenue_last_hour,\r\n",
        "     TIMESTAMPDIFF(MINUTE, last_transaction_time, current_timestamp()) as minutes_since_last_transaction\r\n",
        "   FROM fuel_project_dev.gold.vw_realtime_station_snapshot\r\n",
        "   WHERE transactions_last_hour < 5 \r\n",
        "      OR last_transaction_time < current_timestamp() - interval 30 minute\r\n",
        "   ORDER BY minutes_since_last_transaction DESC;"
      ]
    }
  ],
