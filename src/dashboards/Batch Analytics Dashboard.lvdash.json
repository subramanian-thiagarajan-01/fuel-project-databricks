{
  "datasets": [
    {
      "name": "675a82c8",
      "displayName": "dim_date",
      "queryLines": [
        "SELECT * FROM fuel_project_dev.gold.dim_date"
      ]
    },
    {
      "name": "c3bc4505",
      "displayName": "Recent Station Performance Insights",
      "queryLines": [
        "SELECT \r\n",
        "     SUM(total_revenue) as total_revenue,\r\n",
        "     SUM(total_transactions) as total_transactions,\r\n",
        "     AVG(avg_rating) as avg_customer_rating,\r\n",
        "     SUM(negative_reviews) as total_negative_reviews,\r\n",
        "     ROUND(SUM(total_revenue) / SUM(total_transactions), 2) as avg_transaction_value\r\n",
        "   FROM fuel_project_dev.gold.vw_batch_station_performance\r\n",
        "   WHERE full_date >= current_date() - interval 30 day;"
      ]
    },
    {
      "name": "f07dfd9e",
      "displayName": "Daily Revenue and Ratings Overview",
      "queryLines": [
        "SELECT \r\n",
        "     full_date,\r\n",
        "     SUM(total_revenue) as daily_revenue,\r\n",
        "     AVG(avg_rating) as avg_rating\r\n",
        "   FROM fuel_project_dev.gold.vw_batch_station_performance\r\n",
        "   GROUP BY full_date\r\n",
        "   ORDER BY full_date;"
      ]
    },
    {
      "name": "6f7012ab",
      "displayName": "Station Performance Insights Summary",
      "queryLines": [
        "SELECT \r\n",
        "     station_size_category,\r\n",
        "     SUM(total_revenue) as total_revenue,\r\n",
        "     AVG(revenue_per_employee) as avg_revenue_per_employee,\r\n",
        "     COUNT(DISTINCT fuel_station_id) as station_count\r\n",
        "   FROM fuel_project_dev.gold.vw_batch_station_performance\r\n",
        "   GROUP BY station_size_category;"
      ]
    },
    {
      "name": "91afb056",
      "displayName": "Fuel Revenue Summary by Date Analysis",
      "queryLines": [
        "SELECT \r\n",
        "     full_date,\r\n",
        "     SUM(petrol_revenue) as Petrol,\r\n",
        "     SUM(diesel_revenue) as Diesel,\r\n",
        "     SUM(cng_revenue) as CNG\r\n",
        "   FROM fuel_project_dev.gold.vw_batch_station_performance\r\n",
        "   GROUP BY full_date\r\n",
        "   ORDER BY full_date;"
      ]
    },
    {
      "name": "7ccf338f",
      "displayName": "Fuel Station Ratings and Negative Feedback Summary",
      "queryLines": [
        "SELECT \r\n",
        "     fuel_station_id,\r\n",
        "     AVG(avg_rating) as avg_rating,\r\n",
        "     SUM(negative_reviews) as negative_count\r\n",
        "   FROM fuel_project_dev.gold.vw_batch_station_performance\r\n",
        "   GROUP BY fuel_station_id\r\n",
        "   ORDER BY avg_rating ASC;"
      ]
    }
  ],
